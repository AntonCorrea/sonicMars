config_version=5

[application]

config/name="Marte Sónico"
config/description="Demo accesible audio-first del proyecto Misiones Análogas. Misión de recolección de muestras en Marte guiada por voz y ecolocalización."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[audio]

default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

